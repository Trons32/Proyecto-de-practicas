# Copiar a .env.local en la raíz del repo para que la aplicación use SQL
# Server (SPEC-006). Sin estas dos variables todo sigue en localStorage.
ALMACEN=sql
NEXT_PUBLIC_ALMACEN=sql

# La conexión. En desarrollo, los mismos valores de .env.db.
MSSQL_SERVIDOR=localhost
MSSQL_PUERTO=1433
MSSQL_BASE=asignacion_academica
MSSQL_USUARIO=sa
MSSQL_CLAVE=la-de-.env.db

# Firma de la cookie de sesión (SPEC-008). 32 caracteres o más, distinto en cada servidor:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESION_SECRETO=
