# Variables del servidor de producción (SPEC-010).
# Copiar a .env.production.local en la raíz del proyecto, en el servidor
# (excluido de git por `.env*`), o cargarlas en el panel del hosting.
#
# OJO: NEXT_PUBLIC_ALMACEN se incrusta al compilar. Debe estar definida
# ANTES de `npm run build`; cambiarla después exige volver a compilar.

# ── Almacenamiento en SQL Server ────────────────────────────────────────
ALMACEN=sql
NEXT_PUBLIC_ALMACEN=sql

# ── Conexión a la base ──────────────────────────────────────────────────
# Nombre o IP del servidor SQL tal como se ve DESDE el servidor web.
# Instancia con nombre: MSSQL_SERVIDOR=servidor\INSTANCIA y quite el puerto
# si usa SQL Browser.
MSSQL_SERVIDOR=sqlserver.cecar.edu.co
MSSQL_PUERTO=1433
MSSQL_BASE=asignacion_academica
# El login de db/crear-usuario-app.sql. Nunca `sa`.
MSSQL_USUARIO=app_asignacion
MSSQL_CLAVE=
# 1 (por defecto) acepta certificado autofirmado; 0 exige uno válido.
MSSQL_CONFIAR_CERTIFICADO=1

# ── Sesión ──────────────────────────────────────────────────────────────
# 32+ caracteres, distinto al de desarrollo. Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESION_SECRETO=

# ── Validación de credenciales (API de sistemas) ────────────────────────
# api: valida contra la API institucional (por defecto en producción).
# prueba: usuarios de prueba admin@/coordinador@ — SOLO para ensayos.
AUTH_PROVEEDOR=api
# URL completa del endpoint que valida usuario y clave (método POST).
AUTH_API_URL=
# Si la API exige token: se envía como "Authorization: Bearer <token>".
AUTH_API_TOKEN=
# Nombres de los campos del JSON que espera la API.
AUTH_API_CAMPO_USUARIO=usuario
AUTH_API_CAMPO_CLAVE=clave
# 1 si la API espera el usuario sin "@cecar.edu.co".
AUTH_API_SIN_DOMINIO=0
# Milisegundos antes de dar la API por caída.
AUTH_API_ESPERA_MS=8000
