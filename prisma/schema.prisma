// Modelo de Prisma para la base PostgreSQL (SPEC-011).
//
// Las tablas las crean las migraciones de prisma/migrations, escritas en SQL
// a mano: llevan triggers de "solo se añade", CHECK y permisos que este
// archivo no expresa. Por eso:
//   · nunca `prisma db push`;
//   · para cambiar el esquema: `npx prisma migrate dev --create-only`,
//     completar el SQL a mano, aplicarlo y `npx prisma db pull` para que
//     este archivo lo refleje.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model actividad {
  id                  String           @id(map: "pk_actividad") @db.Uuid
  docente_asignado_id String           @db.Uuid
  clase               String           @db.VarChar(15)
  orden               Int              @db.SmallInt
  rol_id              Int?
  horas               Decimal          @db.Decimal(5, 1)
  docente_asignado    docente_asignado @relation(fields: [docente_asignado_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_actividad_da")
  rol                 rol?             @relation(fields: [rol_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_actividad_rol")

}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asignacion {
  id                                  String              @id(map: "pk_asignacion") @db.Uuid
  periodo                             String              @db.Char(6)
  programa_id                         Int
  estado                              String              @db.VarChar(15)
  version                             Int                 @default(0)
  plazo_correccion                    DateTime?           @db.Timestamptz(6)
  linea_base_fecha                    DateTime?           @db.Timestamptz(6)
  linea_base_version                  Int?
  creada                              DateTime            @db.Timestamptz(6)
  actualizada                         DateTime            @db.Timestamptz(6)
  periodo_asignacion_periodoToperiodo periodo             @relation("asignacion_periodoToperiodo", fields: [periodo], references: [codigo], onDelete: NoAction, onUpdate: NoAction, map: "fk_asignacion_periodo")
  programa                            programa            @relation(fields: [programa_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_asignacion_programa")
  docente_asignado                    docente_asignado[]
  evento_asignacion                   evento_asignacion[]
  linea_base_curso                    linea_base_curso[]

  @@index([periodo, estado], map: "ix_asignacion_periodo")
}

model categoria {
  codigo                                                                           String                          @id(map: "pk_categoria") @db.VarChar(40)
  contrato_dedicacion_categoria_contrato_dedicacion_categoria_categoriaTocategoria contrato_dedicacion_categoria[] @relation("contrato_dedicacion_categoria_categoriaTocategoria")

}

model contrato_dedicacion_categoria {
  tipo_contrato                                                            String             @db.VarChar(40)
  dedicacion                                                               String             @db.VarChar(40)
  categoria                                                                String             @db.VarChar(40)
  categoria_contrato_dedicacion_categoria_categoriaTocategoria             categoria          @relation("contrato_dedicacion_categoria_categoriaTocategoria", fields: [categoria], references: [codigo], onDelete: NoAction, onUpdate: NoAction, map: "fk_cdc_categoria")
  tipo_contrato_contrato_dedicacion_categoria_tipo_contratoTotipo_contrato tipo_contrato      @relation("contrato_dedicacion_categoria_tipo_contratoTotipo_contrato", fields: [tipo_contrato], references: [codigo], onDelete: NoAction, onUpdate: NoAction, map: "fk_cdc_contrato")
  dedicacion_contrato_dedicacion_categoria_dedicacionTodedicacion          dedicacion         @relation("contrato_dedicacion_categoria_dedicacionTodedicacion", fields: [dedicacion], references: [codigo], onDelete: NoAction, onUpdate: NoAction, map: "fk_cdc_dedicacion")
  docente_asignado                                                         docente_asignado[]

  @@id([tipo_contrato, dedicacion, categoria], map: "pk_contrato_dedicacion_categoria")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model convocatoria {
  periodo                               String   @id(map: "pk_convocatoria") @db.Char(6)
  apertura                              DateTime @db.Timestamptz(6)
  limite                                DateTime @db.Timestamptz(6)
  cerrada_manualmente                   Boolean  @default(false)
  periodo_convocatoria_periodoToperiodo periodo  @relation("convocatoria_periodoToperiodo", fields: [periodo], references: [codigo], onDelete: NoAction, onUpdate: NoAction, map: "fk_convocatoria_periodo")

}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model curso_asignado {
  id                  String           @id(map: "pk_curso_asignado") @db.Uuid
  docente_asignado_id String           @db.Uuid
  orden               Int              @db.SmallInt
  codigo_programa     String?          @db.VarChar(10)
  nombre_programa     String?          @db.VarChar(120)
  codigo_pensum       String?          @db.VarChar(20)
  codigo_curso        String?          @db.VarChar(20)
  nombre_curso        String?          @db.VarChar(150)
  semestre            Int?             @db.SmallInt
  grupo               String?          @db.VarChar(5)
  jornada             String?          @db.VarChar(15)
  intensidad_horaria  Decimal?         @db.Decimal(5, 1)
  creditos            Int?             @db.SmallInt
  estudiantes         Int?             @db.SmallInt
  modalidad           String?          @db.VarChar(15)
  docente_asignado    docente_asignado @relation(fields: [docente_asignado_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_curso_da")

}

model dedicacion {
  codigo                                                                             String                          @id(map: "pk_dedicacion") @db.VarChar(40)
  contrato_dedicacion_categoria_contrato_dedicacion_categoria_dedicacionTodedicacion contrato_dedicacion_categoria[] @relation("contrato_dedicacion_categoria_dedicacionTodedicacion")
  regla_dedicacion_regla_dedicacion_dedicacionTodedicacion                           regla_dedicacion?               @relation("regla_dedicacion_dedicacionTodedicacion")

}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model docente {
  id               String             @id(map: "pk_docente") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documento        String             @unique(map: "uq_docente_documento") @db.VarChar(15)
  nombres          String             @db.VarChar(150)
  docente_asignado docente_asignado[]

}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model docente_asignado {
  id                                                          String                         @id(map: "pk_docente_asignado") @db.Uuid
  asignacion_id                                               String                         @db.Uuid
  docente_id                                                  String?                        @db.Uuid
  orden                                                       Int                            @db.SmallInt
  documento                                                   String?                        @db.VarChar(15)
  nombres                                                     String?                        @db.VarChar(150)
  nivel_formacion                                             String?                        @db.VarChar(30)
  perfil_profesional                                          String?
  categoria_minciencias                                       String?                        @db.VarChar(20)
  activo_sector_externo                                       String?                        @db.Char(2)
  sector_ejerce                                               String?                        @db.VarChar(60)
  tipo_contrato                                               String?                        @db.VarChar(40)
  dedicacion                                                  String?                        @db.VarChar(40)
  categoria                                                   String?                        @db.VarChar(40)
  sede                                                        String?                        @db.VarChar(40)
  evaluacion_docente                                          Decimal?                       @db.Decimal(3, 2)
  observaciones                                               String?
  preparacion                                                 Decimal                        @db.Decimal(5, 1)
  atencion                                                    Decimal                        @db.Decimal(5, 1)
  comunidades                                                 Decimal                        @db.Decimal(5, 1)
  actividad                                                   actividad[]
  curso_asignado                                              curso_asignado[]
  asignacion                                                  asignacion                     @relation(fields: [asignacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_da_asignacion")
  contrato_dedicacion_categoria                               contrato_dedicacion_categoria? @relation(fields: [tipo_contrato, dedicacion, categoria], references: [tipo_contrato, dedicacion, categoria], onDelete: NoAction, onUpdate: NoAction, map: "fk_da_cascada")
  tipo_contrato_docente_asignado_tipo_contratoTotipo_contrato tipo_contrato?                 @relation("docente_asignado_tipo_contratoTotipo_contrato", fields: [tipo_contrato], references: [codigo], onDelete: NoAction, onUpdate: NoAction, map: "fk_da_contrato")
  docente                                                     docente?                       @relation(fields: [docente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_da_docente")

  @@unique([asignacion_id, docente_id], map: "uq_da_docente_por_asignacion", where: raw("(docente_id IS NOT NULL)"))
  @@index([asignacion_id, orden], map: "ix_da_asignacion")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model evento_asignacion {
  id            String     @id(map: "pk_evento") @db.Uuid
  asignacion_id String     @db.Uuid
  secuencia     BigInt     @default(autoincrement())
  tipo          String     @db.VarChar(30)
  fecha         DateTime   @db.Timestamptz(6)
  autor         String     @db.VarChar(150)
  rol_autor     String     @db.VarChar(12)
  nota          String?
  plazo         DateTime?  @db.Timestamptz(6)
  version       Int?
  novedad_id    String?    @db.Uuid
  asignacion    asignacion @relation(fields: [asignacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_evento_asignacion")
  novedad       novedad?   @relation(fields: [novedad_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_evento_novedad")

  @@index([asignacion_id, fecha], map: "ix_evento_asignacion")
}

model facultad {
  codigo                               String     @id(map: "pk_facultad") @db.VarChar(80)
  programa_programa_facultadTofacultad programa[] @relation("programa_facultadTofacultad")

}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model limite {
