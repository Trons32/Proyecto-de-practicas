}

model linea_base_curso {
  asignacion_id      String     @db.Uuid
  orden              Int        @db.SmallInt
  curso_id           String     @db.Uuid
  docente_id         String     @db.Uuid
  docente            String?    @db.VarChar(150)
  codigo_curso       String?    @db.VarChar(20)
  nombre_curso       String?    @db.VarChar(150)
  semestre           Int?       @db.SmallInt
  grupo              String?    @db.VarChar(5)
  intensidad_horaria Decimal?   @db.Decimal(5, 1)
  estudiantes        Int?       @db.SmallInt
  asignacion         asignacion @relation(fields: [asignacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lbc_asignacion")

  @@id([asignacion_id, orden], map: "pk_linea_base_curso")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model novedad {
  id                               String               @id(map: "pk_novedad") @db.Uuid
  numero                           Int                  @unique(map: "uq_novedad_numero")
  fecha                            DateTime             @db.Timestamptz(6)
  autor                            String               @db.VarChar(150)
  rol_autor                        String               @db.VarChar(12)
  periodo                          String?              @db.Char(6)
  con_convocatoria_cerrada         Boolean
  motivo                           String
  evento_asignacion                evento_asignacion[]
  periodo_novedad_periodoToperiodo periodo?             @relation("novedad_periodoToperiodo", fields: [periodo], references: [codigo], onDelete: NoAction, onUpdate: NoAction, map: "fk_novedad_periodo")
  novedad_afectacion               novedad_afectacion[]
  novedad_cambio                   novedad_cambio[]

}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
