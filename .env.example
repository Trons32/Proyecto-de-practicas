# Copiar a .env (desarrollo) o .env.production.local (servidor) y completar.
# Los datos se guardan siempre en PostgreSQL.

# ── Base de datos (PostgreSQL) ──────────────────────────────────────────
# En producción, el usuario de la aplicación (miembro de rol_asignacion_app),
# no el dueño de las tablas. TLS hacia otra máquina: añadir
# ?sslmode=no-verify (certificado autofirmado) o ?sslmode=verify-full.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/asignacion_academica

# ── Sesión (NextAuth, SPEC-018) ─────────────────────────────────────────
# 32+ caracteres, distinto en cada servidor:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NextAuth lo lee como AUTH_SECRET; SESION_SECRETO (el nombre de SPEC-008)
# sigue valiendo para no tocar los servidores existentes. Cambiarlo cierra
# todas las sesiones abiertas.
SESION_SECRETO=
# La dirección pública, sin barra final. Obligatoria detrás de un proxy:
# sin ella NextAuth arma la URL con los encabezados X-Forwarded-*, y si el
# proxy los manda con dos valores ("https,http") toda ruta con sesión falla.
AUTH_URL=https://planificacionacademica.cecar.edu.co

# ── Validación de credenciales (SPEC-010, SPEC-018) ─────────────────────
# local: claves creadas en /admin/usuarios. ES LA DEL PILOTO.
# api: valida contra Aldea (por defecto en producción). Pasar de local a
#      api y volver es solo cambiar esta variable y reiniciar (SPEC-018).
# prueba: usuarios de prueba admin@/coordinador@ — SOLO para ensayos.
AUTH_PROVEEDOR=api
# URL completa del endpoint que valida usuario y clave (método POST).
AUTH_API_URL=
# Si la API exige token: se envía como "Authorization: Bearer <token>".
AUTH_API_TOKEN=
# Opcionales: solo si la API difiere de los valores por defecto.
# AUTH_API_CAMPO_USUARIO=usuario
# AUTH_API_CAMPO_CLAVE=clave
# AUTH_API_SIN_DOMINIO=0        # 1 si espera el usuario sin "@cecar.edu.co"
# AUTH_API_ESPERA_MS=8000

# Credenciales locales y correo SMTP (SPEC-014)
# AUTH_PROVEEDOR=local valida los hashes creados desde /admin/usuarios.
# SMTP es opcional: sin él, el administrador entrega la clave temporal
# copiándola, por WhatsApp o desde su correo (SPEC-014).
# Solicite al área de sistemas los datos del relay de CECAR; no suba SMTP_CLAVE.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DESDE=Asignación Académica CECAR <asignacion-academica@cecar.edu.co>
# SMTP_SEGURO=1 solo para SMTPS (normalmente el puerto 465).
SMTP_SEGURO=0

