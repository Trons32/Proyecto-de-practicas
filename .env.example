# Copiar a .env (desarrollo) o .env.production.local (servidor) y completar.
#
# OJO: NEXT_PUBLIC_ALMACEN se incrusta al compilar. Debe estar definida
# ANTES de `npm run build`; cambiarla después exige volver a compilar.

# ── Almacenamiento ──────────────────────────────────────────────────────
# Sin estas dos, todo vive en el navegador (localStorage).
ALMACEN=sql
NEXT_PUBLIC_ALMACEN=sql

# ── Base de datos (PostgreSQL) ──────────────────────────────────────────
# En producción, el usuario de la aplicación (miembro de rol_asignacion_app),
# no el dueño de las tablas. TLS hacia otra máquina: añadir
# ?sslmode=no-verify (certificado autofirmado) o ?sslmode=verify-full.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/asignacion_academica

# ── Sesión ──────────────────────────────────────────────────────────────
# 32+ caracteres, distinto en cada servidor:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESION_SECRETO=

# ── Validación de credenciales (API de sistemas, SPEC-010) ──────────────
# api: valida contra la API institucional (por defecto en producción).
# prueba: usuarios de prueba admin@/coordinador@ — SOLO para ensayos.
AUTH_PROVEEDOR=api
# URL completa del endpoint que valida usuario y clave (método POST).
AUTH_API_URL=
# Si la API exige token: se envía como "Authorization: Bearer <token>".
AUTH_API_TOKEN=
# Nombres de los campos del JSON que espera la API.
AUTH_API_CAMPO_USUARIO=usuario
AUTH_API_CAMPO_CLAVE=clave
# 1 si la API espera el usuario sin "@cecar.edu.co".
AUTH_API_SIN_DOMINIO=0
# Milisegundos antes de dar la API por caída.
AUTH_API_ESPERA_MS=8000
